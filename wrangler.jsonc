{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "senior-ai-life-platform",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./backend/static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "OPENAI_MODEL": "gpt-4.1-mini"
  }
}